# Core runtime
AUTOCONTEXT_AGENT_PROVIDER=deterministic
AUTOCONTEXT_EXECUTOR_MODE=local

# Local paths
AUTOCONTEXT_DB_PATH=runs/autocontext.sqlite3
AUTOCONTEXT_RUNS_ROOT=runs
AUTOCONTEXT_KNOWLEDGE_ROOT=knowledge
AUTOCONTEXT_SKILLS_ROOT=skills
AUTOCONTEXT_CLAUDE_SKILLS_PATH=.claude/skills
AUTOCONTEXT_EVENT_STREAM_PATH=runs/events.ndjson

# Model selection
# Leave these unset to inherit the selected provider's defaults. For a local
# endpoint, AUTOCONTEXT_LOCAL_MODEL fills every otherwise-unset role/tier slot.
# Explicit per-role or per-tier values take precedence over LOCAL_MODEL.
# AUTOCONTEXT_LOCAL_MODEL=qwen3:32b
# Declare where the default endpoint runs and the maximum capability it serves.
# Empty hosting falls back to conservative transport inference.
# AUTOCONTEXT_PROVIDER_HOSTING=local
# AUTOCONTEXT_PROVIDER_CAPABILITY=frontier
# AUTOCONTEXT_MODEL_COMPETITOR=claude-sonnet-5
# AUTOCONTEXT_MODEL_ANALYST=claude-sonnet-5
# AUTOCONTEXT_MODEL_COACH=claude-opus-5
# AUTOCONTEXT_MODEL_ARCHITECT=claude-opus-5
# AUTOCONTEXT_MODEL_TRANSLATOR=claude-sonnet-5
# AUTOCONTEXT_MODEL_CURATOR=claude-opus-5
# OpenAI-compatible role generation uses output schemas by default. Set false
# to send ordinary unconstrained requests and parse the returned Markdown.
AUTOCONTEXT_CONSTRAINED_OUTPUT=true

# API credentials (set when using live providers)
# Prefer provider-native env vars like ANTHROPIC_API_KEY; AUTOCONTEXT_ANTHROPIC_API_KEY remains a compatibility alias.
ANTHROPIC_API_KEY=
AUTOCONTEXT_ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
AUTOCONTEXT_OPENROUTER_API_KEY=
# Compatibility-only: the installed SDK cannot safely receive a per-client custom base URL.
AUTOCONTEXT_PRIMEINTELLECT_API_BASE=https://api.primeintellect.ai
AUTOCONTEXT_PRIMEINTELLECT_API_KEY=
AUTOCONTEXT_PRIMEINTELLECT_DOCKER_IMAGE=python:3.11.10-slim-bookworm@sha256:840e180ebcc6e5c8efab209c43f5e40fd2af98cb49db5c7103c90539c56bb30e
AUTOCONTEXT_PRIMEINTELLECT_CPU_CORES=1.0
AUTOCONTEXT_PRIMEINTELLECT_MEMORY_GB=2.0
AUTOCONTEXT_PRIMEINTELLECT_DISK_SIZE_GB=5.0
AUTOCONTEXT_PRIMEINTELLECT_TIMEOUT_MINUTES=30
AUTOCONTEXT_PRIMEINTELLECT_WAIT_ATTEMPTS=60

# Optional experimental panel/fusion roles (disabled by default)
AUTOCONTEXT_PANEL_ROLES=
AUTOCONTEXT_PANEL_PARTICIPANTS=
AUTOCONTEXT_PANEL_SYNTHESIZER_PROVIDER=
AUTOCONTEXT_PANEL_SYNTHESIZER_MODEL=

# Optional role-scoped provider credentials/endpoints
AUTOCONTEXT_COMPETITOR_API_KEY=
AUTOCONTEXT_COMPETITOR_BASE_URL=
# AUTOCONTEXT_COMPETITOR_PROVIDER_HOSTING=local
# AUTOCONTEXT_COMPETITOR_PROVIDER_CAPABILITY=mid_tier
AUTOCONTEXT_ANALYST_API_KEY=
AUTOCONTEXT_ANALYST_BASE_URL=
# AUTOCONTEXT_ANALYST_PROVIDER_HOSTING=
# AUTOCONTEXT_ANALYST_PROVIDER_CAPABILITY=
AUTOCONTEXT_COACH_API_KEY=
AUTOCONTEXT_COACH_BASE_URL=
# AUTOCONTEXT_COACH_PROVIDER_HOSTING=
# AUTOCONTEXT_COACH_PROVIDER_CAPABILITY=
AUTOCONTEXT_ARCHITECT_API_KEY=
AUTOCONTEXT_ARCHITECT_BASE_URL=
# AUTOCONTEXT_ARCHITECT_PROVIDER_HOSTING=
# AUTOCONTEXT_ARCHITECT_PROVIDER_CAPABILITY=

# Execution / loop tuning
AUTOCONTEXT_DEFAULT_GENERATIONS=1
AUTOCONTEXT_SEED_BASE=1000
AUTOCONTEXT_MATCHES_PER_GENERATION=3
AUTOCONTEXT_ARCHITECT_EVERY_N_GENS=3
AUTOCONTEXT_BACKPRESSURE_MIN_DELTA=0.005
# Experimental annealing gate; disabled by default.
AUTOCONTEXT_EXPERIMENTAL_ANNEALING_ENABLED=false
# Experimental Lévy scout prompt mutation; disabled by default.
AUTOCONTEXT_EXPERIMENTAL_LEVY_SCOUT_ENABLED=false
AUTOCONTEXT_LEVY_SCOUT_ALPHA=1.5
AUTOCONTEXT_LEVY_SCOUT_SCALE=0.2
AUTOCONTEXT_MAX_RETRIES=2
AUTOCONTEXT_RETRY_BACKOFF_SECONDS=0.25
AUTOCONTEXT_HARNESS_PROFILE=standard
AUTOCONTEXT_LEAN_CONTEXT_BUDGET_TOKENS=32000
AUTOCONTEXT_LEAN_HIDDEN_CONTEXT_BUDGET_TOKENS=0
AUTOCONTEXT_LEAN_TOOL_ALLOWLIST=read,bash,edit,write
AUTOCONTEXT_PI_RPC_PERSISTENT=false
AUTOCONTEXT_EXTENSIONS=
AUTOCONTEXT_EXTENSION_FAIL_FAST=false
AUTOCONTEXT_SIMPLICITY_MODE=off

# Outcome-gated context promotion (opt-in). Candidate and incumbent bundles
# are evaluated on fresh matched runs before active.json can change.
AUTOCONTEXT_CONTEXT_BUNDLE_PROMOTION_ENABLED=false
AUTOCONTEXT_CONTEXT_BUNDLE_PROMOTION_MIN_SCREEN_PAIRS=2
AUTOCONTEXT_CONTEXT_BUNDLE_PROMOTION_MIN_CONFIRMATION_PAIRS=6
AUTOCONTEXT_CONTEXT_BUNDLE_PROMOTION_MAX_CONFIRMATION_PAIRS=20
AUTOCONTEXT_CONTEXT_BUNDLE_PROMOTION_MIN_HELDOUT_PAIRS=2
AUTOCONTEXT_CONTEXT_BUNDLE_PROMOTION_MIN_EFFECT=0.0
AUTOCONTEXT_CONTEXT_BUNDLE_PROMOTION_CONFIDENCE_Z=1.96
AUTOCONTEXT_CONTEXT_BUNDLE_PROMOTION_SEED_BASE=50000
AUTOCONTEXT_CONTEXT_BUNDLE_PROMOTION_EVAL_TIMEOUT_SECONDS=10.0
AUTOCONTEXT_CONTEXT_BUNDLE_PROMOTION_EVAL_MAX_MEMORY_MB=512
AUTOCONTEXT_CONTEXT_BUNDLE_PROMOTION_FAMILYWISE_ALPHA=0.05
AUTOCONTEXT_CONTEXT_BUNDLE_PROMOTION_ALLOCATION_DECAY=0.5
AUTOCONTEXT_CONTEXT_BUNDLE_PROMOTION_MIN_INDEPENDENT_BLOCKS=2
AUTOCONTEXT_CONTEXT_BUNDLE_PROMOTION_ROBUST_METHOD=cluster_t

# Independent read-only campaign auditor (opt-in). This route must differ from
# the proposer unless the explicit same-route escape hatch is enabled.
AUTOCONTEXT_CAMPAIGN_AUDITOR_ENABLED=false
AUTOCONTEXT_CAMPAIGN_AUDITOR_PROVIDER=anthropic
AUTOCONTEXT_CAMPAIGN_AUDITOR_MODEL=claude-opus-5
# Optional dedicated route values. Auditor traffic never inherits agent/judge
# endpoints or generic agent/judge credentials.
AUTOCONTEXT_CAMPAIGN_AUDITOR_BASE_URL=
AUTOCONTEXT_CAMPAIGN_AUDITOR_API_KEY=
AUTOCONTEXT_CAMPAIGN_AUDITOR_PROPOSER_PROVIDER=anthropic
AUTOCONTEXT_CAMPAIGN_AUDITOR_PROPOSER_MODEL=claude-sonnet-5
AUTOCONTEXT_CAMPAIGN_AUDITOR_ALLOW_SAME_ROUTE=false
AUTOCONTEXT_CAMPAIGN_AUDITOR_MAX_CALLS_PER_CAMPAIGN=8
AUTOCONTEXT_CAMPAIGN_AUDITOR_MAX_INPUT_CHARS=24000
AUTOCONTEXT_CAMPAIGN_AUDITOR_MAX_OUTPUT_TOKENS=1200
AUTOCONTEXT_CAMPAIGN_AUDITOR_TIMEOUT_SECONDS=30.0
AUTOCONTEXT_CAMPAIGN_AUDITOR_POLICY=advisory
AUTOCONTEXT_CAMPAIGN_AUDITOR_INPUT_COST_PER_MILLION=0.0
AUTOCONTEXT_CAMPAIGN_AUDITOR_OUTPUT_COST_PER_MILLION=0.0

# PrimeIntellect resilience
AUTOCONTEXT_PRIMEINTELLECT_MAX_RETRIES=2
AUTOCONTEXT_PRIMEINTELLECT_BACKOFF_SECONDS=0.75
AUTOCONTEXT_ALLOW_PRIMEINTELLECT_FALLBACK=false

# Local sandbox behavior
AUTOCONTEXT_LOCAL_SANDBOX_HARDENED=true
# Optional OS-isolated code/research evolution. Enabling candidate execution
# requires backend=docker and an explicit capabilities approval.
AUTOCONTEXT_WORKSPACE_INTERPRETER_ENABLED=false
AUTOCONTEXT_WORKSPACE_INTERPRETER_BACKEND=interpreter
AUTOCONTEXT_WORKSPACE_INTERPRETER_EXECUTE_CANDIDATES=false
AUTOCONTEXT_WORKSPACE_INTERPRETER_CAPABILITIES_APPROVED=false
AUTOCONTEXT_WORKSPACE_INTERPRETER_TIMEOUT_SECONDS=10
AUTOCONTEXT_WORKSPACE_INTERPRETER_ALLOWED_IMPORTS=[]
AUTOCONTEXT_WORKSPACE_INTERPRETER_ALLOWED_COMMANDS=[]
AUTOCONTEXT_WORKSPACE_INTERPRETER_DOCKER_IMAGE=python:3.11.10-slim-bookworm@sha256:840e180ebcc6e5c8efab209c43f5e40fd2af98cb49db5c7103c90539c56bb30e
AUTOCONTEXT_WORKSPACE_INTERPRETER_MEMORY_MB=512
AUTOCONTEXT_WORKSPACE_INTERPRETER_CPU_COUNT=1.0
AUTOCONTEXT_WORKSPACE_INTERPRETER_PIDS_LIMIT=64
AUTOCONTEXT_WORKSPACE_INTERPRETER_MAX_FILE_BYTES=8388608
AUTOCONTEXT_WORKSPACE_INTERPRETER_MAX_WORKSPACE_BYTES=67108864
AUTOCONTEXT_WORKSPACE_INTERPRETER_MAX_WORKSPACE_INODES=4096

# API server (autoctx serve / autoctx tui)
# Comma-separated origins allowed to call the HTTP API cross-origin.
# Defaults cover local GUI clients (cowork desktop and dev servers);
# set this for remote or custom GUI deployments.
AUTOCONTEXT_CORS_ORIGINS=http://localhost:1420,http://localhost:4173,http://localhost:3000,tauri://localhost

# Optional browser exploration (secure defaults)
AUTOCONTEXT_BROWSER_ENABLED=false
AUTOCONTEXT_BROWSER_BACKEND=chrome-cdp
AUTOCONTEXT_BROWSER_PROFILE_MODE=ephemeral
AUTOCONTEXT_BROWSER_ALLOWED_DOMAINS=
AUTOCONTEXT_BROWSER_ALLOW_AUTH=false
AUTOCONTEXT_BROWSER_ALLOW_UPLOADS=false
AUTOCONTEXT_BROWSER_ALLOW_DOWNLOADS=false
AUTOCONTEXT_BROWSER_CAPTURE_SCREENSHOTS=true
AUTOCONTEXT_BROWSER_HEADLESS=true
AUTOCONTEXT_BROWSER_DEBUGGER_URL=http://127.0.0.1:9222
AUTOCONTEXT_BROWSER_PREFERRED_TARGET_URL=
AUTOCONTEXT_BROWSER_DOWNLOADS_ROOT=
AUTOCONTEXT_BROWSER_UPLOADS_ROOT=
