{
  "name": "autoctx",
  "version": "0.17.3",
  "description": "autocontext — always-on agent evaluation harness",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "**/control-plane/actuators/**"
  ],
  "_sideEffects_false_subpaths": [
    "./production-traces/**",
    "./integrations/_shared/**",
    "./integrations/openai/**",
    "./integrations/anthropic/**"
  ],
  "files": [
    "README.md",
    "dist",
    "dashboard",
    "migrations",
    "protocol-fixtures"
  ],
  "keywords": [
    "agents",
    "autocontext",
    "evaluation",
    "harness",
    "llm",
    "mcp"
  ],
  "bin": {
    "autoctx": "dist/cli/index.js",
    "autocontext": "dist/cli/autocontext-shim.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server/protocol": {
      "import": "./dist/server/protocol.js",
      "types": "./dist/server/protocol.d.ts"
    },
    "./server/ws-server": {
      "import": "./dist/server/ws-server.js",
      "types": "./dist/server/ws-server.d.ts"
    },
    "./server/run-manager": {
      "import": "./dist/server/run-manager.js",
      "types": "./dist/server/run-manager.d.ts"
    },
    "./protocol-fixtures/structured-task-create-v1.json": "./protocol-fixtures/structured-task-create-v1.json",
    "./protocol-fixtures/agent-task-outcome-v1.json": "./protocol-fixtures/agent-task-outcome-v1.json",
    "./control-plane/runtime": {
      "import": "./dist/control-plane/runtime/index.js",
      "types": "./dist/control-plane/runtime/index.d.ts"
    },
    "./control-plane/eval-ledger": {
      "import": "./dist/control-plane/eval-ledger/index.js",
      "types": "./dist/control-plane/eval-ledger/index.d.ts"
    },
    "./control-plane/contract-probes": {
      "import": "./dist/control-plane/contract-probes/index.js",
      "types": "./dist/control-plane/contract-probes/index.d.ts"
    },
    "./control-plane/memory-packs": {
      "import": "./dist/control-plane/memory-packs/index.js",
      "types": "./dist/control-plane/memory-packs/index.d.ts"
    },
    "./control-plane/external-evals": {
      "import": "./dist/control-plane/external-evals/index.js",
      "types": "./dist/control-plane/external-evals/index.d.ts"
    },
    "./control-plane/agent-app-node": {
      "import": "./dist/control-plane/agent-app-node/index.js",
      "types": "./dist/control-plane/agent-app-node/index.d.ts"
    },
    "./control-plane/agent-app-fetch": {
      "import": "./dist/control-plane/agent-app-fetch/index.js",
      "types": "./dist/control-plane/agent-app-fetch/index.d.ts"
    },
    "./production-traces": {
      "types": "./dist/production-traces/sdk/index.d.ts",
      "import": "./dist/production-traces/sdk/index.js",
      "require": "./dist/cjs/production-traces/sdk/index.cjs"
    },
    "./integrations/_shared": {
      "types": "./dist/integrations/_shared/index.d.ts",
      "import": "./dist/integrations/_shared/index.js",
      "require": "./dist/cjs/integrations/_shared/index.cjs"
    },
    "./integrations/anthropic": {
      "types": "./dist/integrations/anthropic/index.d.ts",
      "import": "./dist/integrations/anthropic/index.js",
      "require": "./dist/cjs/integrations/anthropic/index.cjs"
    },
    "./integrations/openai": {
      "types": "./dist/integrations/openai/index.d.ts",
      "import": "./dist/integrations/openai/index.js",
      "require": "./dist/cjs/integrations/openai/index.cjs"
    },
    "./integrations/browser": {
      "types": "./dist/integrations/browser/index.d.ts",
      "import": "./dist/integrations/browser/index.js"
    },
    "./runtimes/mcp": {
      "types": "./dist/runtimes/mcp-runtime-tools.d.ts",
      "import": "./dist/runtimes/mcp-runtime-tools.js"
    },
    "./agent-runtime": {
      "types": "./dist/agent-runtime/index.d.ts",
      "import": "./dist/agent-runtime/index.js"
    },
    "./harness-optimization/evidence": {
      "import": "./dist/harness-optimization/evidence.js",
      "types": "./dist/harness-optimization/evidence.d.ts"
    },
    "./harness-optimization/scoring": {
      "import": "./dist/harness-optimization/scoring.js",
      "types": "./dist/harness-optimization/scoring.d.ts"
    },
    "./harness-optimization/contract/validators": {
      "import": "./dist/harness-optimization/contract/validators.js",
      "types": "./dist/harness-optimization/contract/validators.d.ts"
    },
    "./context-bundles": {
      "import": "./dist/context-bundles/index.js",
      "types": "./dist/context-bundles/index.d.ts"
    },
    "./detectors/openai-python": {
      "types": "./dist/control-plane/instrument/detectors/openai-python/index.d.ts",
      "import": "./dist/control-plane/instrument/detectors/openai-python/index.js",
      "require": "./dist/cjs/control-plane/instrument/detectors/openai-python/index.cjs"
    },
    "./detectors/openai-ts": {
      "types": "./dist/control-plane/instrument/detectors/openai-ts/index.d.ts",
      "import": "./dist/control-plane/instrument/detectors/openai-ts/index.js",
      "require": "./dist/cjs/control-plane/instrument/detectors/openai-ts/index.cjs"
    },
    "./detectors/anthropic-python": {
      "types": "./dist/control-plane/instrument/detectors/anthropic-python/index.d.ts",
      "import": "./dist/control-plane/instrument/detectors/anthropic-python/index.js",
      "require": "./dist/cjs/control-plane/instrument/detectors/anthropic-python/index.cjs"
    },
    "./detectors/anthropic-ts": {
      "types": "./dist/control-plane/instrument/detectors/anthropic-ts/index.d.ts",
      "import": "./dist/control-plane/instrument/detectors/anthropic-ts/index.js",
      "require": "./dist/cjs/control-plane/instrument/detectors/anthropic-ts/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc && npm run build:cli-contract && npm run build:role-output-schemas && npm run build:production-traces-sdk-cjs && npm run build:public-subpaths-cjs",
    "build:browser-contract-types": "node scripts/generate-browser-contract-types.mjs",
    "build:cli-contract": "node scripts/copy-cli-contract.mjs",
    "build:role-output-schemas": "node scripts/copy-role-output-schemas.mjs",
    "generate:root-index": "node scripts/generate-root-index.mjs",
    "check:root-index": "node scripts/generate-root-index.mjs --check",
    "build:production-traces-sdk-cjs": "node scripts/build-production-traces-sdk-cjs.mjs",
    "build:public-subpaths-cjs": "node scripts/build-public-subpaths-cjs.mjs",
    "test": "vitest run",
    "test:runtime-confluence:sweep": "AUTOCTX_CONFLUENCE_RUNS=500 vitest run tests/runtime-composition-confluence.test.ts tests/runtime-composition-faults.test.ts tests/runtime-composition-observability.test.ts",
    "test:watch": "vitest",
    "check:test-types": "tsc -p tsconfig.test.json",
    "lint": "npm run check:root-index && tsc --noEmit && npm run check:test-types",
    "example:repl": "node examples/run-repl-session.mjs",
    "sync:browser-contract-schemas": "node scripts/sync-python-browser-contract-schemas.mjs",
    "build:production-traces-types": "node scripts/generate-production-traces-types.mjs",
    "check:browser-contract-schemas": "node scripts/generate-browser-contract-types.mjs --check && node scripts/sync-python-browser-contract-schemas.mjs --check",
    "sync:production-traces-schemas": "node scripts/sync-python-production-traces-schemas.mjs",
    "check:production-traces-schemas": "node scripts/generate-production-traces-types.mjs --check && node scripts/sync-python-production-traces-schemas.mjs --check",
    "build:harness-optimization-types": "node scripts/generate-harness-optimization-types.mjs",
    "check:harness-optimization-schemas": "node scripts/generate-harness-optimization-types.mjs --check && node scripts/sync-python-harness-optimization-schemas.mjs --check",
    "check:instrument-schemas": "node scripts/check-instrument-schemas.mjs --check",
    "check:role-routing-contract": "node scripts/generate-role-routing-contract.mjs --check",
    "check:schemas": "npm run check:production-traces-schemas && npm run check:browser-contract-schemas && npm run check:instrument-schemas && npm run check:harness-optimization-schemas && npm run check:role-routing-contract",
    "check:sdk-import-discipline": "node scripts/check-sdk-import-discipline.mjs",
    "check:production-traces-sdk-bundle-size": "node scripts/check-production-traces-sdk-bundle-size.mjs",
    "check:side-effects": "node scripts/check-side-effects.mjs",
    "check:license-compatibility": "node scripts/check-license-compatibility.mjs",
    "check:no-postinstall-scripts": "node scripts/check-no-postinstall-scripts.mjs",
    "check:no-telemetry": "node scripts/check-no-telemetry.mjs",
    "check:integrations-openai-bundle-size": "node scripts/check-integrations-openai-bundle-size.mjs",
    "check:integrations-anthropic-bundle-size": "node scripts/check-integrations-anthropic-bundle-size.mjs",
    "check:a2-ii-a-all": "npm run check:sdk-import-discipline && npm run check:side-effects && npm run check:production-traces-sdk-bundle-size && npm run check:license-compatibility && npm run check:no-postinstall-scripts && npm run check:no-telemetry",
    "regenerate-cross-runtime-fixtures": "node scripts/regenerate-cross-runtime-fixtures.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greyhaven-ai/autocontext.git"
  },
  "homepage": "https://github.com/greyhaven-ai/autocontext/tree/main/ts",
  "bugs": {
    "url": "https://github.com/greyhaven-ai/autocontext/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.18 <2",
    "openai": "^4"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "overrides": {
    "@hono/node-server": "1.19.15",
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "ip-address": "10.3.1",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.23"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@apidevtools/json-schema-ref-parser": "^15.3.5",
    "@types/better-sqlite3": "^7.6.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.27.1",
    "fast-check": "^4.7.0",
    "json-schema-to-typescript": "^15.0.4",
    "openai": "^4",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.84.2",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^11.0.0",
    "diff": "^9.0.0",
    "ignore": "5.3.2",
    "secure-exec": "^0.3.3",
    "sharp": "0.35.3",
    "tree-sitter": "0.21.1",
    "tree-sitter-javascript": "0.21.4",
    "tree-sitter-python": "0.21.0",
    "tree-sitter-typescript": "0.21.2",
    "tsx": "^4.21.0",
    "ulid": "^3.0.2",
    "undici": "8.9.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  }
}
