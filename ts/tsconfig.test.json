{
  // Type-checking for test files (npm run check:test-types).
  //
  // The main tsconfig excludes tests/, so vitest runs them without any type
  // checking; a test can silently drift from the API it pins (AC-898 review
  // found a scope-guardrail probe that omitted the required scope argument).
  //
  // AC-909 inverted this from an opt-in allowlist to an opt-out denylist:
  // every test file is checked by default, and the files still carrying
  // pre-existing branded-type debt are listed in "exclude" below. That way a
  // NEW test file is type-checked the moment it is written, with no ritual
  // step to remember. The exclude list only shrinks; deleting its last entry
  // removes the mechanism.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
