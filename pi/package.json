{
  "name": "pi-autocontext",
  "version": "0.12.0",
  "description": "autocontext extension for Pi coding agent — iterative strategy generation, LLM judging, and evaluation tools",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "autocontext",
    "autoctx",
    "evaluation",
    "llm",
    "judging"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/greyhaven-ai/autocontext",
    "directory": "pi"
  },
  "homepage": "https://github.com/greyhaven-ai/autocontext/tree/main/pi",
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "autoctx": "^0.19.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "isolated-vm@6.1.2": true
  },
  "overrides": {
    "@hono/node-server": "1.19.15",
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.8",
    "hono": "4.13.11",
    "ip-address": "10.7.4",
    "@modelcontextprotocol/sdk": "1.32.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "protobufjs": "7.6.5",
    "sharp": "0.35.5",
    "undici": "8.12.2",
    "pbkdf2": "3.1.7",
    "proxy-addr": "2.0.8",
    "source-map-js": "1.2.2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "typebox": "^1.3.28",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "files": [
    "src",
    "skills",
    "prompts",
    "types",
    "README.md"
  ],
  "scripts": {
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc",
    "prepublishOnly": "npm run lint && npm test",
    "test:runtime-contract": "node tests/installed-runtime-contract.mjs"
  }
}
