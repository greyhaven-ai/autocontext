  "known_divergences": [
    {
      "case": "explicit_override.mixed_case_provider_name",
      "role": "competitor",
      "settings": {
        "competitor_provider": "Ollama"
      },
      "context": {},
      "python": {
        "provider_type": "Ollama",
        "model": "competitor-role-model",
