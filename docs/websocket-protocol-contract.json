{
  "version": 1,
  "contract": "interactive WebSocket protocol surface shared by Python and TypeScript with runtime-only extensions marked explicitly",
  "protocol_version": 2,
  "structured_task_creation_extension": {
    "capability": "structured_task_creation_v1",
    "advertised_runtimes": ["typescript"],
    "command": "create_task",
    "contract": "ImprovementTaskContractSchema@1",
    "source_content_boundary": "TaskDataSourceContentSchema",
    "candidate_hidden_roles": ["eval"],
    "eval_behavior": "raw eval content is available to the judge for each attempt and is never rendered into candidate generation or revision context",
    "unsupported_roles": ["holdout"],
    "holdout_behavior": "rejected until winner-only post-loop verification is implemented",
    "source_content_completeness": "exactly one inline content entry is required for every manifest source",
    "source_integrity": "utf8 byte length and sha256 are verified before role routing",
    "package_fixture": "protocol-fixtures/structured-task-create-v1.json",
    "setup_sequence": ["scenario_generating", "scenario_preview", "confirm_scenario ack", "scenario_ready"],
    "setup_failure": "invalid or unpersistable tasks terminate with an actionable error and never advertise scenario_ready",
    "python_support": "deferred"
  },
  "agent_task_outcome_extension": {
    "capability": "agent_task_outcome_v1",
    "schema_version": 1,
    "advertised_runtimes": ["typescript"],
    "applies_to": "completed saved agent_task runs",
    "terminal_event": "run_completed",
    "terminal_payload_field": "agent_task_outcome",
    "terminal_receipt_fields": [
      "schema_version",
      "termination_reason",
      "quality_threshold",
      "met_threshold",
      "completed_iterations",
      "max_iterations",
      "best_iteration",
      "best_score"
    ],
    "evaluation_event": "generation_completed",
    "evaluation_fields": [
      "generation",
      "mean_score",
      "reasoning",
      "dimension_scores",
      "judge_failed",
      "evaluator_epoch"
    ],
    "inspection_path": "/api/cockpit/runs/:run_id/inspection",
    "inspection_field": "agent_task_outcome",
    "durability": "the terminal receipt and per-generation evaluator evidence are retained in the transcript; the complete versioned outcome is retained in SQLite and returned by Cockpit inspection",
    "derivation": "directly from ImprovementResult and AgentTaskSpec; no generated-package parsing or additional model synthesis",
    "package_fixture": "protocol-fixtures/agent-task-outcome-v1.json",
    "python_support": "deferred"
  },
  "transcript_extension": {
    "capability": "run_transcript_v1",
    "transcript_protocol_version": 1,
    "opt_in_query": "transcript_protocol_version=1",
    "legacy_default": true,
    "resume_command": "resume_run",
    "identity_fields": ["client_run_id", "event_id", "sequence", "occurred_at"],
    "retention": {
      "bounded": true,
      "max_age_days": 7,
      "max_file_bytes": 33554432,
      "max_frames": 20000,
      "max_frames_per_run": 2000,
      "max_commands": 20000,
      "idempotency_horizon": "same as retained command and response records"
    }
  },
  "image_attachment_extension": {
    "capability": "image_attachments_v1",
    "advertised_runtimes": ["typescript"],
    "advertisement": "dynamic_for_active_provider_and_model",
    "protocol_version": 2,
    "additive_commands": ["chat_agent", "inject_hint"],
    "field": "image_attachments",
    "attachment": {
      "required_fields": [
        "id",
        "name",
        "source",
        "media_type",
        "data_base64",
        "byte_length",
        "content_sha256",
        "width",
        "height"
      ],
      "sources": ["picker", "paste", "drop"],
      "media_types": ["image/png", "image/jpeg", "image/gif", "image/webp"],
      "canonical_base64": true,
      "unique_fields": ["id", "content_sha256"],
      "verified_before_provider": [
        "decoded_byte_length",
        "sha256",
        "format_header",
        "encoded_dimensions"
      ]
    },
    "limits": {
      "max_attachments": 4,
      "max_decoded_bytes_per_image": 5242880,
      "max_encoded_bytes_per_image": 7340032,
      "max_dimension": 8192,
      "max_decoded_rgba_bytes_per_image": 67108864,
      "max_aggregate_encoded_bytes": 20971520
    },
    "provider_delivery": {
      "anthropic": "base64_image_block_with_exact_verified_bytes",
      "openai": "data_url_image_part_with_exact_verified_bytes",
      "unknown_compatible_gateway": "fail_closed_unless_explicitly_opted_in"
    },
    "python_support": "deferred"
  },
  "agent_task_plan_extension": {
    "capability": "agent_task_plan_v1",
    "advertised_runtimes": ["typescript"],
    "requires_transcript_protocol_version": 1,
    "event": "task_plan_updated",
    "event_order": [
      "run_started",
      "task_plan_updated:initial",
      "task_plan_updated:progress_or_replan",
      "task_plan_updated:terminal_snapshot",
      "run_completed_or_run_failed_or_run_stopped"
    ],
    "payload": {
      "required_fields": [
        "run_id",
        "plan_id",
        "version",
        "plan_revision",
        "update_kind",
        "active_step_id",
        "steps"
      ],
      "optional_fields": ["summary"],
      "update_kinds": ["initial", "progress", "replan"],
      "step_statuses": [
        "pending",
        "in_progress",
        "completed",
        "blocked",
        "failed",
        "skipped",
        "interrupted"
      ],
      "step_count": { "minimum": 1, "maximum": 50 },
      "id": {
        "maximum_characters": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "credential_shaped_values_allowed": false
      },
      "copy_limits": {
        "label_characters": 160,
        "detail_characters": 2000,
        "summary_characters": 240,
        "aggregate_characters": 20000,
        "empty_or_whitespace_only_values_allowed": false
      },
      "full_snapshot": true,
      "initial_version": 1,
      "initial_plan_revision": 1,
      "version_rule": "strictly_increases_for_every_update",
      "progress_revision_rule": "unchanged",
      "replan_revision_rule": "strictly_increases",
      "completed_steps_are_sticky": true,
      "active_step_rule": "zero_or_one_in_progress_step_exactly_matches_active_step_id",
      "terminal_snapshot_rule": "active_step_id_is_null_and_no_step_is_in_progress"
    },
    "identity": {
      "payload_run_id_matches_outer_run_id": true,
      "stable_fields": ["run_id", "plan_id"],
      "outer_transcript_fields": ["client_run_id", "event_id", "sequence", "occurred_at"]
    },
    "retention": {
      "full_snapshot_or_drop": true,
      "max_serialized_event_bytes": 12288,
      "redacted_before_persistence": true,
      "restart_replay": true
    },
    "python_support": "deferred_until_durable_transcript_metadata_is_available"
  },
  "agent_progress_note_extension": {
    "capability": "agent_progress_notes_v1",
    "advertised_runtimes": ["typescript"],
    "requires_transcript_protocol_version": 1,
    "event": "agent_progress_note",
    "payload": {
      "required_fields": ["run_id", "generation", "kind", "text"],
      "optional_fields": ["evidence_targets"],
      "unknown_field_policy": "forbid",
      "generation": {
        "integer": true,
        "minimum": 0
      },
      "kinds": ["intent", "discovery", "decision", "verification", "blocker"],
      "copy_limits": {
        "text_characters": 480,
        "empty_or_whitespace_only_values_allowed": false
      },
      "evidence_targets": {
        "maximum_items": 5,
        "unique": true,
        "identity_rule": "json_tuple_of_kind_action_id_and_optional_artifact_id",
        "variants": {
          "action": {
            "required_fields": ["kind", "action_id"]
          },
          "artifact": {
            "required_fields": ["kind", "action_id", "artifact_id"]
          }
        },
        "id": {
          "maximum_characters": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "credential_shaped_values_allowed": false
        },
        "resolution_rule": "every_target_must_resolve_to_an_earlier_action_detail_in_the_same_retained_client_run",
        "artifact_rule": "artifact_id_must_belong_to_the_referenced_action",
        "invalid_target_rule": "reject_the_entire_note"
      }
    },
    "identity": {
      "payload_run_id_matches_outer_run_id": true,
      "outer_transcript_fields": ["client_run_id", "event_id", "sequence", "occurred_at"]
    },
    "safety": {
      "agent_authored_summary_only": true,
      "hidden_reasoning_allowed": false,
      "raw_prompts_allowed": false,
      "raw_model_or_tool_io_allowed": false,
      "credentials_allowed": false,
      "urls_allowed": false,
      "selectors_allowed": false,
      "redacted_and_rebounded_before_emission": true
    },
    "retention": {
      "full_note_or_drop": true,
      "max_serialized_event_bytes": 4096,
      "redacted_before_persistence": true,
      "exact_live_replay_parity": true,
      "restart_replay": true,
      "finite_horizon": "same_as_the_retained_run_transcript"
    },
    "fixture": {
      "type": "event",
      "event": "agent_progress_note",
      "run_id": "engine-run-1",
      "client_run_id": "control-run-1",
      "event_id": "progress-event-1",
      "sequence": 2,
      "occurred_at": "2026-07-27T15:00:02.000Z",
      "payload": {
        "run_id": "engine-run-1",
        "generation": 1,
        "kind": "discovery",
        "text": "The retained source confirms the release is reversible.",
        "evidence_targets": [
          {
            "kind": "action",
            "action_id": "inspect-release"
          },
          {
            "kind": "artifact",
            "action_id": "inspect-release",
            "artifact_id": "release-report"
          }
        ]
      }
    },
    "python_support": "deferred_until_durable_transcript_metadata_is_available"
  },
  "safe_stop_extension": {
    "capability": "safe_run_stop_v1",
    "advertised_runtimes": ["typescript", "python"],
    "command": "stop",
    "required_command_fields": ["client_run_id", "command_id"],
    "ack_action": "stop",
    "terminal_event": "run_stopped",
    "terminal_reason": "operator",
    "terminal_arbitration": "first_terminal_outcome_wins",
    "base_idempotency": "live",
    "python_support": "supported",
    "durable_reconnect_replay": {
      "requires_transcript_protocol_version": 1,
      "advertised_runtimes": ["typescript"],
      "note": "Reconnect-after-terminal replay of the acknowledgement and terminal receipt requires run_transcript_v1 and is TypeScript-only. The base cooperative stop advertised by both runtimes offers live (within-run) idempotency: duplicate or reconnected commands are deduplicated while the run is active, but once the run reaches a terminal state a later command is answered as not-active rather than replayed."
    }
  },
  "system_map_projection_extension": {
    "capability": "system_map_projection_v1",
    "advertised_runtimes": ["typescript"],
    "endpoint": "/ws/events",
    "query": {
      "projection": "system-map",
      "optional_run_scope": "run_id",
      "optional_view": {
        "parameter": "view",
        "values": ["execution", "context", "activation", "routing"],
        "default": "execution"
      }
    },
    "event": "system_map_transfer",
    "channel": "cockpit",
    "payload": {
      "version": 1,
      "required_fields": [
        "version",
        "id",
        "sourceSequence",
        "timestamp",
        "runId",
        "traceId",
        "spanId",
        "spanName",
        "spanPhase",
        "startedAt",
        "event",
        "edgeId",
        "from",
        "to",
        "kind",
        "label",
        "status",
        "summary"
      ],
      "optional_fields": [
        "generation",
        "attempt",
        "parentSpanId",
        "endedAt",
        "payloadBytes",
        "durationMs"
      ],
      "statuses": ["started", "completed", "retry", "failed"]
    },
    "trace": {
      "version": 1,
      "source": "EventStreamRecord.trace",
      "phases": ["start", "complete", "instant"],
      "paired_boundaries": ["run", "generation", "role", "tournament", "persistence"],
      "raw_payload_copied": false
    },
    "safety": {
      "allowlisted_summary_fields_only": true,
      "raw_prompts_allowed": false,
      "raw_model_or_tool_io_allowed": false,
      "credentials_allowed": false,
      "bounded_replay": true
    },
    "python_support": "deferred"
  },
  "endpoints": [
    {
      "path": "/ws/interactive",
      "runtimes": ["python", "typescript"],
      "message_contract": "interactive"
    },
    {
      "path": "/ws/events",
      "runtimes": ["python", "typescript"],
      "message_contract": "event-stream"
    }
  ],
  "top_level_unknown_field_policy": "forbid",
  "event_stream_envelope": {
    "version": 1,
    "unknown_field_policy": "forbid",
    "required_fields": ["ts", "v", "seq", "channel", "event", "payload"],
    "fields": {
      "ts": {
        "type": "string",
        "format": "date-time"
      },
      "v": {
        "type": "integer",
        "const": 1
      },
      "seq": {
        "type": "integer",
        "minimum": 1
      },
      "channel": {
        "type": "string",
        "known_values": ["generation", "mission", "notebook", "cockpit"]
      },
      "event": {
        "type": "string"
      },
      "payload": {
        "type": "object"
      }
    }
  },
  "shared_server_messages": [
    "hello",
    "event",
    "state",
    "chat_response",
    "environments",
    "run_accepted",
    "ack",
    "error",
    "scenario_generating",
    "scenario_preview",
    "scenario_ready",
    "scenario_error",
    "monitor_alert"
  ],
  "shared_client_messages": [
    "pause",
    "resume",
    "stop",
    "inject_hint",
    "override_gate",
    "chat_agent",
    "start_run",
    "list_scenarios",
    "create_scenario",
    "confirm_scenario",
    "revise_scenario",
    "cancel_scenario"
  ],
  "typescript_only_server_messages": [
    {
      "type": "auth_status",
      "reason": "TypeScript TUI provider-auth workflow"
    },
    {
      "type": "mission_progress",
      "reason": "TypeScript mission dashboard workflow"
    }
  ],
  "typescript_only_client_messages": [
    {
      "type": "resume_run",
      "reason": "TypeScript durable run transcript resume/backfill extension"
    },
    {
      "type": "create_task",
      "reason": "TypeScript structured improvement-task authoring extension"
    },
    {
      "type": "login",
      "reason": "TypeScript TUI provider-auth workflow"
    },
    {
      "type": "logout",
      "reason": "TypeScript TUI provider-auth workflow"
    },
    {
      "type": "switch_provider",
      "reason": "TypeScript TUI provider-auth workflow"
    },
    {
      "type": "whoami",
      "reason": "TypeScript TUI provider-auth workflow"
    }
  ],
  "python_only_server_messages": [],
  "python_only_client_messages": []
}
